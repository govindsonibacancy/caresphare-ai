# Base URL of the CareSphere AI backend API
VITE_API_BASE_URL=http://localhost:8000

# Supabase project used for authentication.
# Safe for the browser: this is the public anon key, not the service-role
# key (that one is backend-only - see backend/.env.example).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
