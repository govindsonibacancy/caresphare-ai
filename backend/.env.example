APP_NAME=CareSphere AI
ENVIRONMENT=development

# PostgreSQL (+ pgvector extension). Uses the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://caresphere:caresphere@localhost:5432/caresphere

# Supabase Auth (project settings -> API)
SUPABASE_URL=
# Defaults to "${SUPABASE_URL}/auth/v1" if left empty.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Backend-only secret (GoTrue Admin API). NEVER prefix with VITE_ or put in
# frontend code - see backend/app/auth/supabase_admin.py.
SUPABASE_SERVICE_ROLE_KEY=

# Hospital assigned to self-registered patients (see database/README.md).
DEFAULT_PATIENT_HOSPITAL_CODE=CGH

# Employee invitations (see docs/EMPLOYEE_INVITATIONS.md)
EMPLOYEE_INVITATION_EXPIRY_DAYS=7
FRONTEND_BASE_URL=http://localhost:5173

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# LLM answer generation - see docs/LLM_GENERATION.md. A separate model from
# EMBEDDING_MODEL below (run `ollama pull llama3.2:3b`).
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_LLM_TIMEOUT_SECONDS=60
OLLAMA_LLM_TEMPERATURE=0.1
OLLAMA_LLM_TOP_P=0.9
OLLAMA_LLM_SEED=42

# Embedding model - served locally by Ollama (run `ollama pull all-minilm`),
# not a Python ML library - see docs/RAG_INGESTION.md, "Embedding model".
# Must produce EMBEDDING_DIMENSION-length vectors (see
# database/migrations/0013_document_chunks.sql).
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSION=384

# RAG document ingestion (see docs/RAG_INGESTION.md)
DOCUMENT_STORAGE_PATH=./data/documents
MAX_DOCUMENT_UPLOAD_SIZE_MB=20
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=150

# RAG hybrid search + reranking (see docs/RAG_HYBRID_SEARCH.md)
RAG_VECTOR_CANDIDATE_MULTIPLIER=4
RAG_LEXICAL_CANDIDATE_MULTIPLIER=4
RAG_VECTOR_WEIGHT=0.7
RAG_LEXICAL_WEIGHT=0.3
RAG_RRF_K=60
RAG_RERANK_EXACT_MATCH_BONUS=0.05
RAG_MAX_CHUNKS_PER_DOCUMENT=3

# LLM answer generation context limits (see docs/LLM_GENERATION.md)
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_CHARS=20000
RAG_ANSWER_NO_CONTEXT_MESSAGE=I couldn't find enough information in the available hospital knowledge base to answer that question.

# Bounded conversation support (see docs/CONVERSATIONAL_AUTH_ROUTING.md)
CONVERSATION_MAX_TURNS=10
CONVERSATION_MAX_MESSAGE_CHARS=4000
CONVERSATION_MAX_CONTEXT_CHARS=8000
CONVERSATION_RETENTION_DAYS=30

# CORS - comma-separated list is parsed as JSON array by pydantic-settings, e.g.:
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
